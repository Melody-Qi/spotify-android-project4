<?xml version="1.0" encoding="utf-8"?>
<!--
  Lesson 54, step 3 - the whole screen, three blocks top to bottom:
    1. FrameLayout (weight=1) holding the NavHostFragment  -> the content area
    2. a 1dp divider
    3. BottomNavigationView                                -> the tabs
  The graph is attached in code (navController.setGraph(...)), so there is no
  app:navGraph attribute here - that is exactly how the lesson does it.

  Lesson 61, screenshot 02 - the floating player bar. It goes INSIDE the
  FrameLayout, as the LAST child so it draws on top of the NavHostFragment, and
  with layout_gravity="bottom" so it hugs the bottom edge of the content area
  (i.e. right above the bottom navigation). Putting it here rather than in each
  Fragment is the whole point of the lesson: the bar must survive navigation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true" />

        <!-- Screenshot 02: the player bar host. android:name wires the ComposeView
             up, R.id.player_bar is what MainActivity does findViewById on, and
             the content itself is set in code with setContent { }. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/player_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_60" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
